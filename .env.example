# --- Deployment -------------------------------------------------------------
# Externally reachable base URL, including any path prefix the reverse proxy
# mounts this app under. Every URL the app advertises is derived from it, so a
# wrong value fails the KiCad handshake outright rather than degrading.
#
#   root:          https://library.example.com
#   path-prefixed: https://sameisky.tech/kicadLibrary
#
# Must be https:// in production: OAuth2 and Secure cookies will not work over http.
PUBLIC_URL=https://library.example.com
PORT=8000

PROVIDER_NAME=KiCad Library Manager
PROVIDER_VERSION=0.1.0

# --- Authentication ---------------------------------------------------------
# When false, the provider advertises auth type "none" and the panel is open to
# anyone who can reach the URL.
AUTH_ENABLED=false

# Any OIDC provider that supports PKCE on a public client and a dynamic
# 127.0.0.1 loopback redirect. KiCad opens the system browser and listens on
# 127.0.0.1/oauth/callback with an ephemeral port, so the IdP must allow a
# wildcard loopback redirect URI.
#
# Known to work: Keycloak, Authentik, Auth0, Zitadel, Google, GitLab.
# Does NOT work: GitHub OAuth Apps (no RFC 8414 metadata, no PKCE).
OIDC_METADATA_URL=https://idp.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=kicad-library-manager
# Keep this minimal. KiCad stores its token bundle in the OS credential
# store, which on Windows caps at 2560 bytes (~1280 UTF-16 chars). authentik's
# "profile" scope adds the group list and can push the bundle over that,
# failing with "Failed to store remote provider tokens securely".
OIDC_SCOPES=openid,email
# Set only if your provider issues JWT access tokens with an audience claim.
#OIDC_AUDIENCE=kicad-library-manager

# --- Sessions ---------------------------------------------------------------
NONCE_TTL_SECONDS=120
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=klm_session
# Defaults to true when PUBLIC_URL is https.
#COOKIE_SECURE=true

# --- Security headers -------------------------------------------------------
# HSTS is emitted only on HTTPS requests (X-Forwarded-Proto is honoured behind
# a TLS-terminating proxy), so leaving it on is safe during http-only testing.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# Preload is close to irreversible -- browsers ship the list and removal takes
# months. Only enable on a domain you are certain will stay HTTPS forever.
HSTS_PRELOAD=false

# --- Capabilities -----------------------------------------------------------
# KiCad refuses to register a provider that advertises neither asset
# transport, so these stay on even while the catalog is empty.
CAPABILITY_DIRECT_DOWNLOADS=true
CAPABILITY_INLINE_PAYLOADS=true
CAPABILITY_PARTS=false
MAX_DOWNLOAD_BYTES=67108864
SUPPORTED_ASSET_TYPES=symbol,footprint,3dmodel
ALLOW_INSECURE_LOCALHOST=true

# --- Library sources --------------------------------------------------------
# JSON array of git repositories to index. Several are supported because a
# company library, the official KiCad libraries and a vendor library are
# separate repositories with separate owners.
LIBRARY_SOURCES=[{"id":"company","name":"Company Library","url":"https://github.com/TeodorSameisky/KicadLibrary.git","ref":"main"}]

# Persistent directory for the clones. Must be on a volume: re-cloning every
# deploy is slow and pointless.
LIBRARY_WORKDIR=/data/sources

# KiCad files received assets under "<prefix>_<library>". This must match the
# "Library prefix" in KiCad's Remote Symbol Settings, or placed symbols point
# at footprint libraries the user does not have.
REMOTE_LIBRARY_PREFIX=remote
