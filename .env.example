# --- Deployment -------------------------------------------------------------
# Externally reachable base URL, including any path prefix the reverse proxy
# mounts this app under. Every URL the app advertises is derived from it, so a
# wrong value fails the KiCad handshake outright rather than degrading.
#
#   root:          https://library.example.com
#   path-prefixed: https://sameisky.tech/kicadLibrary
#
# Must be https:// in production: OAuth2 and Secure cookies will not work over http.
PUBLIC_URL=https://library.example.com
PORT=8000

# What KiCad shows for this provider. The version defaults to the app's own.
PROVIDER_NAME=KiCad Library Manager
#PROVIDER_VERSION=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# "json" writes one object per line, for a log aggregator.
LOG_FORMAT=text

# --- Authentication ---------------------------------------------------------
# When false, the provider advertises auth type "none" and the library can be
# read by anyone who can reach the URL. When true, every endpoint that reads the
# library needs a session.
AUTH_ENABLED=false

# Any OIDC provider that supports PKCE on a public client and a dynamic
# 127.0.0.1 loopback redirect. KiCad opens the system browser and listens on
# 127.0.0.1/oauth/callback with an ephemeral port, so the IdP must allow a
# wildcard loopback redirect URI.
#
# Known to work: Keycloak, Authentik, Auth0, Zitadel, Google, GitLab.
# Does NOT work: GitHub OAuth Apps (no RFC 8414 metadata, no PKCE).
OIDC_METADATA_URL=https://idp.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=kicad-library-manager
# Keep this minimal. KiCad stores its token bundle in the OS credential store,
# which on Windows holds 2560 bytes (~1280 characters). A bundle over that
# fails after a successful login with "Failed to store remote provider tokens
# securely". What counts is what the provider puts in the tokens for these
# scopes: sign with an elliptic-curve key (ES256), and make sure its "profile"
# mapping does not emit names and group lists. One claim naming the user
# (preferred_username) is enough.
OIDC_SCOPES=openid,email
# Set only if your provider issues JWT access tokens with an audience claim.
#OIDC_AUDIENCE=kicad-library-manager

# --- Librarians -------------------------------------------------------------
# Who may refresh the library and delete BOMs. Comma-separated usernames,
# e-mail addresses or subject ids, as the identity provider reports them.
# Listed here rather than taken from a group claim, because a claim would be
# carried in KiCad's tokens and those are already close to the limit above.
# With AUTH_ENABLED=false everyone counts as a librarian.
LIBRARIANS=

# --- Browser sign-in --------------------------------------------------------
# A placed symbol's Datasheet field points at this app's part page, and that
# link is followed in a normal browser -- from a schematic, or from a PDF
# export with no KiCad running at all. The WebView's cookie does not reach
# there, so the browser signs in against the same provider with THIS APP as
# the OAuth2 client.
#
# The provider must allow this exact redirect URI for OIDC_CLIENT_ID, in
# addition to KiCad's loopback one:
#
#     <PUBLIC_URL>/auth/callback
#
# The status page at / prints it. Turn this off only if you want part pages
# reachable solely from inside KiCad.
WEB_LOGIN_ENABLED=true
# Leave unset for a public client, which is the normal case: PKCE is what
# proves the exchange. Set it only if you registered a confidential client.
#OIDC_CLIENT_SECRET=

# --- Sessions ---------------------------------------------------------------
NONCE_TTL_SECONDS=120
# A browser sign-in can involve a password, consent and a second factor, so it
# gets longer than the nonce that only crosses from KiCad to its own WebView.
LOGIN_TTL_SECONDS=600
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=klm_session
# Defaults to true when PUBLIC_URL is https.
#COOKIE_SECURE=true

# --- Security headers -------------------------------------------------------
# HSTS is emitted only on HTTPS requests (X-Forwarded-Proto is honoured behind
# a TLS-terminating proxy), so leaving it on is safe during http-only testing.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# Preload is close to irreversible -- browsers ship the list and removal takes
# months. Only enable on a domain you are certain will stay HTTPS forever.
HSTS_PRELOAD=false

# --- Capabilities -----------------------------------------------------------
# KiCad refuses to register a provider that advertises neither asset
# transport, so these stay on even while the catalog is empty.
CAPABILITY_DIRECT_DOWNLOADS=true
CAPABILITY_INLINE_PAYLOADS=true
CAPABILITY_PARTS=false
MAX_DOWNLOAD_BYTES=67108864
SUPPORTED_ASSET_TYPES=symbol,footprint,3dmodel
ALLOW_INSECURE_LOCALHOST=true

# --- Library sources --------------------------------------------------------
# JSON array of git repositories to index. Several are supported because a
# company library, the official KiCad libraries and a vendor library are
# separate repositories with separate owners.
LIBRARY_SOURCES=[{"id":"company","name":"Company Library","url":"https://github.com/TeodorSameisky/KicadLibrary.git","ref":"main"}]

# Parts (IPNs) are read from the first source that has a parts/ directory.
#
# A token that may push to the library's repository. With it, parts can be
# requested, corrected and approved in the app, each as a commit in the name
# of whoever did it. Without it the app only reads the library.
# On GitHub: a fine-grained personal access token limited to the library's
# repository, with "Contents: read and write". Keep it out of git.
#LIBRARY_WRITE_TOKEN=

# How often to look for new commits when nothing has said there are any.
# 0 never looks: a restart, a librarian or the webhook below has to.
LIBRARY_REFRESH_MINUTES=15
# Set this, and add a webhook for push events in GitHub or Gitea pointing at
#     <PUBLIC_URL>/api/v1/library/webhook
# with the same secret, to have a pushed part appear within seconds.
#WEBHOOK_SECRET=

# A source that needs a token to be read has "private": true in its entry:
#   [{"id":"company","url":"https://github.com/acme/library.git","private":true}]
# The token is sent only to sources marked private, and only over https.
# A token that may read them. If this is not set, LIBRARY_WRITE_TOKEN is used.
#LIBRARY_READ_TOKEN=

# Persistent directory for the clones. Must be on a volume: re-cloning every
# deploy is slow and pointless.
LIBRARY_WORKDIR=/data/sources

# KiCad files received assets under "<prefix>_<library>". This must match the
# "Library prefix" in KiCad's Remote Symbol Settings, or placed symbols point
# at footprint libraries the user does not have.
REMOTE_LIBRARY_PREFIX=remote

# --- Bills of materials -----------------------------------------------------
# The SQLite file uploaded BOMs are kept in. It is the one thing here that
# cannot be rebuilt from somewhere else, so it belongs on a volume that is
# backed up. The file is created on first use; its directory has to exist.
DATABASE_PATH=/data/library-manager.db
# Daily copies of it, made beside it and kept this many (0: none). They are on
# the same disk, so they do not protect against losing the volume: download a
# copy now and then from the status page, and back the volume up if you can.
BACKUP_KEEP=14
#BACKUP_DIRECTORY=/data/backups

# --- Suppliers ---------------------------------------------------------------
# A part's page shows what suppliers say about its manufacturer parts: stock,
# status, prices. A supplier without keys is asked nothing.
#
# DigiKey: the client id and secret of an application registered at
# developer.digikey.com and subscribed to "Product Information v4". Set these
# in the deployment's environment. They do not belong in a file that is
# committed, this one included.
#DIGIKEY_CLIENT_ID=
#DIGIKEY_CLIENT_SECRET=
# Whose prices and stock. For Germany: DE, en (or de), EUR.
#DIGIKEY_LOCALE_SITE=US
#DIGIKEY_LOCALE_LANGUAGE=en
#DIGIKEY_LOCALE_CURRENCY=USD
# How many searches a day may be sent to DigiKey. It allows a registered
# application a thousand; this app stops itself before DigiKey has to, and the
# status page shows how many have gone.
#DIGIKEY_DAILY_LIMIT=1000
# The sandbox answers the same way with made-up data, for trying the keys out.
#DIGIKEY_API_URL=https://sandbox-api.digikey.com
#
# Mouser: the key for its Search API, from mouser.com/api-hub. The key decides
# whose prices: Mouser ties it to the country and currency of the account.
# Set it in the deployment's environment, not in a file that is committed.
#MOUSER_API_KEY=
#MOUSER_DAILY_LIMIT=1000
#
# Farnell (and Newark, and element14): the key of an application registered
# at partner.element14.com for the Product Search API. Set it in the
# deployment's environment, not in a file that is committed.
#FARNELL_API_KEY=
# Which country's catalogue. For Germany: de.farnell.com. For the United
# States: www.newark.com.
#FARNELL_STORE=uk.farnell.com
# What that store's prices are in, if it cannot be worked out from the store.
#FARNELL_CURRENCY=
#FARNELL_DAILY_LIMIT=1000
#
# How long a supplier's answer holds before the same thing is asked again.
#SUPPLIER_CACHE_HOURS=24
